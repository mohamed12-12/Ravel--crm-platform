# App
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5001
APP_SECRET_KEY=
LOG_LEVEL=INFO

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=

# Sheet backend
SHEET_BACKEND=excel
EXCEL_SOURCE_WORKBOOK="RT - Travelers Database.phase5.ready.xlsx"
EXCEL_RUNTIME_WORKBOOK="RT - Travelers Database.phase5.demo.xlsx"
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Instagram / Meta
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v19.0
PUBLIC_WEBHOOK_URL=

# Human handoff and operations
HUMAN_HANDOFF_PHONE=
HUMAN_HANDOFF_EMAIL=
ADMIN_ALERT_WEBHOOK_URL=
DEMO_RESET_ON_START=false
DEFAULT_COUNTRY_CODE=20
DEMO_WRITE_MODE=demo
