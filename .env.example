# Rahma Travel OS environment template.
# Copy to .env and fill real values locally. Do not commit real secrets.

# Spreadsheet demo Flask app (services/ai_agent/ai_agent_app)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3001
APP_DEBUG=false
APP_USE_RELOADER=false
APP_SECRET_KEY=
LOG_LEVEL=INFO

# Data authority and integration boundaries
DATA_AUTHORITY=crm
DATA_SCHEMA_VERSION=1
CRM_ACCESS_MODE=shared_service
CRM_API_BASE_URL=
EXCEL_IMPORT_ENABLED=true
EXCEL_EXPORT_ENABLED=true
GOOGLE_SHEETS_IMPORT_ENABLED=false
GOOGLE_SHEETS_EXPORT_ENABLED=false
DIRECT_IMPORT_APPLY_ENABLED=false
CRM_SHEET_MIRROR_ENABLED=false
DEMO_DATA_MODE=true

# Database-backed Flask CRM (apps/api)
FLASK_CONFIG=development
FLASK_ENV=development
SECRET_KEY=
# apps/middleware also reads the generic PORT var below (for itself) - this
# gives the CRM/API its own dedicated port setting so the two don't collide
# when both read this same .env file. See apps/api/run.py.
CRM_API_PORT=5000
CRM_AUTH_ENABLED=true
ADMIN_USERNAME=
ADMIN_PASSWORD=
CRM_API_TOKEN=
DATABASE_URL=sqlite:///rahma_traveler_dev.db
# Explicit staging PostgreSQL target for migration/validation scripts only.
# Example: postgresql://rahma_app:<password>@<host>:5432/rahma_traveler_staging?sslmode=require
POSTGRES_URL=
USD_TO_EGP_RATE=50.0
EXCEL_FILE_PATH=data/travelers_database.xlsx
GOOGLE_CREDS_PATH=

# Middleware API (apps/middleware only - see CRM_API_PORT above for apps/api)
PORT=3000
FLASK_API_URL=

# AI provider placeholders
AI_AGENT_MODE=tool_calling
AI_MAX_TOOL_ROUNDS=4
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
AI_AGENT_SYSTEM_PROMPT=
AI_AGENT_SYSTEM_PROMPT_FILE=services/ai_agent/ai_agent_app/prompts/gemini_agent_system.md
AGENT_CONVERSATION_PROMPT=
AGENT_CONVERSATION_PROMPT_FILE=services/ai_agent/ai_agent_app/prompts/agent_conversation.md
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_PERSONA_NAME=Rahma

# Agent write-tool safety gates (see services/ai_agent/ai_agent_app/config.py).
# AGENT_WRITE_TOOL_ENFORCEMENT must be true in production - the app refuses to
# start in production with it unset/false.
AGENT_TOOL_ROUTER_MODE=dry_run
AGENT_WRITE_TOOL_ENFORCEMENT=false

# Path override for the CRM SQLite database used by services/crm/system_services
# and services/data_authority.py when running the agent in shared_service mode.
# Leave unset to use the DATABASE_URL-derived default.
RAHMA_SYSTEM_DB_PATH=

# Upload storage overrides. Leave unset locally (both fall back to an
# instance-relative folder); set to durable paths (or EFS/S3-backed mounts)
# in production - see .env.production.example.
TRAVELER_UPLOAD_ROOT=
AI_AGENT_UPLOAD_ROOT=

WEBSITE_URL=
POST_TRIP_HANDOFF_ENABLED=false
POST_TRIP_HANDOFF_KEYWORDS=help,support,agent,human,assistance
POST_TRIP_HANDOFF_RESPONSIBLE_EMPLOYEE=Operations Team

# Sheet backend
SHEET_BACKEND=excel
EXCEL_SOURCE_WORKBOOK="archive/source-artifacts/RT - Travelers Database.phase5.ready.xlsx"
EXCEL_RUNTIME_WORKBOOK="archive/source-artifacts/RT - Travelers Database.phase5.demo.xlsx"
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Instagram / Meta placeholders
# TODO(production): replace placeholders with a secret manager and page-scoped Meta token handling.
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=
PUBLIC_WEBHOOK_URL=
# Page/Instagram Business Account ID this deployment processes events for.
# Leave blank in local dev; required for the page-id check in production
# (see services/instagram/webhooks.py).
META_PAGE_ID=

# Human handoff and operations
HUMAN_HANDOFF_PHONE=
HUMAN_HANDOFF_EMAIL=
ADMIN_ALERT_WEBHOOK_URL=
DEMO_RESET_ON_START=false
DEFAULT_COUNTRY_CODE=20
DEMO_WRITE_MODE=demo
